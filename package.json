{
  "name": "nx-rh",
  "version": "0.5.1",
  "description": "npx-repo-hub — 本机仓库与 Agent Skill 的统一管理中枢：Web 面板与同构 CLI 共享同一 service 层",
  "type": "module",
  "bin": {
    "nx-rh": "bin/cli.mjs"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:serve": "node bin/cli.mjs serve --no-open",
    "start": "pnpm run build && node bin/cli.mjs serve",
    "test": "pnpm run build && node tests/smoke.mjs"
  },
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/On-DevPlan/nx-rh.git"
  },
  "homepage": "https://github.com/On-DevPlan/nx-rh#readme",
  "bugs": {
    "url": "https://github.com/On-DevPlan/nx-rh/issues"
  },
  "engines": {
    "node": ">=18.17"
  },
  "files": [
    "bin/",
    "src/",
    "assets/",
    "README.md"
  ],
  "prepublishOnly": "pnpm run build && pnpm test",
  "keywords": [
    "cli",
    "web-panel",
    "repo-manager",
    "agent-tools",
    "skills",
    "symlink",
    "npx"
  ],
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
