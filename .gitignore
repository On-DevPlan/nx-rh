# 依赖与产物
node_modules/

# 前端构建产物（vite build 输出，serve 与发版前生成）
src/web/public/
*.log

# 工作区私有数据
.workbuddy/
.workbuddy-ai/

# Cloned repositories (nested git repos)
# 父目录必须用 /* 半透明模式，否则否定规则失效
.claude/repo/*
!.claude/repo/_read/
!.claude/repo/_read/**

!.claude/repo/_self/
!.claude/repo/_self/**

# Tool artifacts / scratch tools (本地工具产物，不入库)
.tool/
.claude/settings.local.json

# Python 字节码（assets/rh-gitsync/scripts/ 的本地调试残留，不能进发布包）
__pycache__/
*.pyc

# 兄弟项目 nx-kv 的本地 checkout（另一个仓库，不入库）
nx-kv/
