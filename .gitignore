# 依赖与产物
node_modules/

# 前端构建产物（vite build 输出，serve 与发版前生成）
src/web/public/
*.log

# 工作区私有数据
.workbuddy/

# Cloned repositories (nested git repos)
# 父目录必须用 /* 半透明模式，否则否定规则失效
.claude/repo/*
!.claude/repo/_read/
!.claude/repo/_read/**

!.claude/repo/_self/
!.claude/repo/_self/**

# Tool artifacts / scratch tools (本地工具产物，不入库)
.tool/
